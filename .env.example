# RBIRAG LLM providers — all optional.
#
# Answer synthesis works without any key via the anonymous Kilo gateway
# (free models, blank key). If that gateway is down or rate-limited, the app
# falls back to the next provider with a key, and finally to extractive mode
# (retrieved passages with citations, no generation). Retrieval + citations
# never depend on an LLM.
#
# Keyless fallback (no key needed): kilo-free
# Keyed providers (lead by default when a key is set):
# GROQ_API_KEY=            # https://console.groq.com  (openai/gpt-oss-120b)
# NVIDIA_API_KEY=          # https://build.nvidia.com (nemotron-3-ultra-550b-a55b)
# GEMINI_API_KEY=          # https://aistudio.google.com (gemini-2.5-flash)
#
# Override the failover order (comma-separated provider names):
# REGINTEL_LLM_ORDER=kilo-free,groq,nvidia-build,gemini
#
# Or force a single OpenAI-compatible endpoint:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=qwen3:14b
#
# Retrieval tuning (optional):
# REGINTEL_EMBED=BAAI/bge-small-en-v1.5
# REGINTEL_RERANK=cross-encoder/ms-marco-MiniLM-L-6-v2
# REGINTEL_ABSTAIN=-6.0
